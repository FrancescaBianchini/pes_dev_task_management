<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_project_task_epic_list" model="ir.ui.view">
        <field name="name">project.task.epic.list</field>
        <field name="model">project.task.epic</field>
        <field name="arch" type="xml">
            <tree string="Epics">
                <field name="name"/>
                <field name="project_id"/>
                <field name="tag_ids" widget="many2many_tags" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_project_task_epic_form" model="ir.ui.view">
        <field name="name">project.task.epic.form</field>
        <field name="model">project.task.epic</field>
        <field name="arch" type="xml">
            <form string="Epic">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="project_id"/>
                        </group>
                        <group>
                            <field name="tag_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Tasks" name="tasks_page">
                            <field name="task_ids">
                                <tree string="Tasks">
                                    <field name="name"/>
                                    <field name="stage_id"/>
                                    <field name="user_ids" widget="many2many_avatar_user"/>
                                    <field name="date_deadline"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_project_task_epic" model="ir.actions.act_window">
        <field name="name">Epics</field>
        <field name="res_model">project.task.epic</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_project_task_epic"
              name="Epics"
              parent="project.menu_main_pm"
              action="action_project_task_epic"
              sequence="16"/>

</odoo>
