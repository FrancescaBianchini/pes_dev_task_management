<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree view (editable in line) -->
    <record id="view_project_application_tree" model="ir.ui.view">
        <field name="name">project.application.tree</field>
        <field name="model">project.application</field>
        <field name="arch" type="xml">
            <tree string="Applications" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_project_application_form" model="ir.ui.view">
        <field name="name">project.application.form</field>
        <field name="model">project.application</field>
        <field name="arch" type="xml">
            <form string="Application">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="color" widget="color_picker"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search view -->
    <record id="view_project_application_search" model="ir.ui.view">
        <field name="name">project.application.search</field>
        <field name="model">project.application</field>
        <field name="arch" type="xml">
            <search string="Applications">
                <field name="name"/>
                <filter string="Archived" name="inactive" domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_project_application" model="ir.actions.act_window">
        <field name="name">Applications</field>
        <field name="res_model">project.application</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_project_application_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea una nuova Application
            </p><p>
                Le Application sono utilizzate come tag sui task dei progetti
                di sviluppo. Possono essere gestite solo da questo menu.
            </p>
        </field>
    </record>

    <!-- Menu sotto Progetto / Configurazione -->
    <menuitem id="menu_project_application"
              name="Applications"
              parent="project.menu_project_config"
              action="action_project_application"
              sequence="50"/>

</odoo>
